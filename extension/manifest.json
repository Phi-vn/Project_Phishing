{
  "manifest_version": 3,
  "name": "Project Phishing Protector",
  "version": "1.0.0",
  "description": "Tiện ích phát hiện và cảnh báo website lừa đảo qua AI",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Phishing"
  }
}